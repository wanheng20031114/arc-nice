[resource]
script = ExtResource("1_script")
research_id = &"hydrangea_rain_tower_crafting"
display_name = "紫阳花雨幕塔培育研究"
description = "提交共享仓库材料，完成后本局所有玩家都可在简易制作中培育紫阳花雨幕塔，也可在植物培育中心培育。"
result_summary = "解锁紫阳花雨幕塔简易制作与培育配方"
