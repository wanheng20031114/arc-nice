[ext_resource type="Script" path="res://resources/config/pickup_config.gd" id="4_pickup_script"]

[resource]
script = ExtResource("1_script")
research_id = &"vegetation_stake_spread_enhancement"
display_name = "植被桩蔓延增强"
description = "提交共享仓库材料，完成后本局所有植被桩的剩余草地蔓延进度以2倍速推进：基础每圈10秒，强化后每圈5秒；已经过去的时间不会追溯加速。"
result_summary = "植被桩蔓延速率 ×2"
input_items = Array[ExtResource("4_pickup_script")]([ExtResource("2_plank"), ExtResource("3_water")])
input_amounts = Array[int]([20, 5])
duration_seconds = 60.0
effect_type = 4
effect_amount = 2.0
