[ext_resource type="Script" path="res://resources/config/pickup_config.gd" id="2_script"]

[resource]
script = ExtResource("2_script")
pickup_type = 5
display_name = "银面具"
drop_weight = 0.0
description = "受到的背面远程伤害降低25%。"
can_store_in_inventory = true
icon_texture = ExtResource("1_icon")
icon_scale = Vector2(1, 1)
duration = 0.0
collectible_effect_id = "silver_mask"
collectible_rarity = 1
collectible_design_id = "silver_mask"
collectible_design_note = "银面具规则：远程伤害来源位于角色背面时，受击原始伤害乘以0.75。同一方向的多个收藏品倍率在属性刷新时彼此连乘；每次远程受击只按角色朝向与伤害来源方向的点积择一结算：点积不小于0.35时使用正面总倍率，不大于-0.35时使用背面总倍率，中间侧向区间使用1；正面与背面倍率不会在同一次受击中连乘，所选倍率乘算后四舍五入且进入防御结算前至少为1点。副本规则：相同collectible_effect_id的重复副本仍可放入背包并携带，但仅1份参与效果计算，其余副本不生效。"
incoming_ranged_back_damage_multiplier = 0.75
metadata/_custom_type_script = "uid://qucrregg4cq0"
