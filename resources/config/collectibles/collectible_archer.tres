[resource]
script = ExtResource("2_script")
pickup_type = 5
display_name = "弓箭手"
drop_weight = 0.0
description = "每8秒向360范围内最近3名敌人射箭，每支造成攻击力200%的物理伤害。"
can_store_in_inventory = true
icon_texture = ExtResource("1_icon")
duration = 0.0
collectible_effect_id = "archer"
collectible_rarity = 2
collectible_design_id = "archer"
collectible_design_note = "弓箭手规则：首次等待8秒且之后每8秒，选择持有者周围360范围内最近的至多3名存活敌人并各发射1箭；每箭先将当前攻击力×2四舍五入并至少取1，再加当前物理伤害加成，出手值至少为1点物理伤害；命中后减去目标有效物理防御并至少取1，再乘目标承伤倍率并四舍五入，最终至少为1点；没有有效目标时本次不发射但仍重新开始周期计时。副本规则：相同collectible_effect_id的重复副本仍可放入背包并携带，但仅1份参与效果计算，其余副本不生效。"
periodic_effect_id = "archer"
periodic_interval = 8.0
periodic_radius = 360.0
periodic_attack_damage_multiplier = 2.0
periodic_target_count = 3
metadata/_custom_type_script = "uid://qucrregg4cq0"
