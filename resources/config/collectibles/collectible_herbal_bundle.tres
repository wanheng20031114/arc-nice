collectible_design_id = "herbal_bundle"
collectible_design_note = "草药束规则：攻击命中基础伤害后仍存活的敌人时，先以12%概率判定；判定成功且不在冷却时先启动1秒冷却，再治疗命中点36范围内所有存活友方3点生命，且不超过各自生命上限；多个命中附加效果按背包槽及有效副本顺序依次处理；任一效果（包括处决）使目标死亡后立即停止后续命中附加效果，再按同一有效顺序处理击杀效果。副本规则：相同collectible_effect_id的重复副本仍可放入背包并携带，但仅1份参与效果计算，其余副本不生效。"
on_hit_effect_id = "bloom"
on_hit_chance = 0.12
on_hit_cooldown = 1.0
on_hit_radius = 36.0
on_hit_heal = 3
