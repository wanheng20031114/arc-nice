collectible_effect_id = "orange"
collectible_rarity = 1
collectible_design_id = "orange"
collectible_design_note = "橙子规则：每个生效副本使普通射击不消耗弹药的概率增加10个百分点；该概率与角色自身免耗弹概率相加，最终钳制在0%至100%。副本规则：相同collectible_effect_id最多前10份参与效果计算；第11份及以后仍可放入背包并携带，但不再生效。角色兼容：候选池仅向普通攻击可生成投射物且具备弹药与换弹机制的角色提供此收藏品。"
collectible_stacks_by_copy = true
collectible_max_copies = 10
requires_projectile_primary_attack = true
requires_ammunition = true
