[resource]
script = ExtResource("2_script")
pickup_type = 5
display_name = "月亮护符"
drop_weight = 0.0
description = "使用技能时生成半径64的月盾，持续8秒，月盾内友方受到伤害减半。"
can_store_in_inventory = true
icon_texture = ExtResource("1_icon")
duration = 0.0
collectible_effect_id = "moon_amulet"
collectible_rarity = 2
collectible_design_id = "moon_amulet"
collectible_design_note = "月亮护符规则：每次技能成功发动时，以持有者为中心生成半径64、持续8秒的月盾；进入月盾的友方获得50%伤害减免，离开或月盾结束时移除；多个减伤来源只取最高减伤比例；物理或法术防御先完成减伤并至少得到1点，之后再计算max(floor(防御后伤害×(1-最高减伤比例)),1)，因此奇数伤害向下取整且最终伤害至少为1点。副本规则：相同collectible_effect_id的重复副本仍可放入背包并携带，但仅1份参与效果计算，其余副本不生效。"
skill_effect_id = "moon_shield"
skill_effect_radius = 64.0
skill_effect_duration = 8.0
metadata/_custom_type_script = "uid://qucrregg4cq0"
