[resource]
script = ExtResource("2_script")
pickup_type = 5
display_name = "香蕉"
drop_weight = 0.0
description = "普通子弹有30%概率获得中等偏强的追踪能力（可叠加）。"
can_store_in_inventory = true
icon_texture = ExtResource("1_icon")
icon_scale = Vector2(1, 1)
duration = 0.0
collectible_effect_id = "banana"
collectible_rarity = 1
collectible_design_id = "banana"
collectible_design_note = "香蕉规则：每个生效副本使普通子弹追踪概率增加30个百分点；所有追踪概率按百分点相加，最终钳制在0%至100%。追踪判定成功时，在角色周围256范围、射击方向左右各60度内，从最多64个候选中选最近敌人；子弹以每秒5.5弧度转向，目标死亡或命中该目标后停止追踪。副本规则：相同collectible_effect_id最多前4份参与效果计算；第5份及以后仍可放入背包并携带，但不再生效。角色兼容：候选池仅向普通攻击可生成投射物的角色提供此收藏品。"
collectible_stacks_by_copy = true
collectible_max_copies = 4
requires_projectile_primary_attack = true
bullet_homing_chance = 0.3
metadata/_custom_type_script = "uid://qucrregg4cq0"
