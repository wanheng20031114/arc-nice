[resource]
script = ExtResource("2_script")
pickup_type = 5
display_name = "中世纪盾牌"
drop_weight = 0.0
description = "受到远程攻击时，额外20%概率闪避。"
can_store_in_inventory = true
icon_texture = ExtResource("1_icon")
duration = 0.0
collectible_effect_id = "medieval_shield"
collectible_rarity = 1
collectible_design_id = "medieval_shield"
collectible_design_note = "中世纪盾牌规则：收到标记为远程的伤害时，每个生效副本额外提供20个百分点闪避概率；所有收藏品远程闪避概率按百分点相加，最终钳制在0%至100%；角色普通闪避先独立判定，仅普通闪避失败后再判定这项收藏品远程闪避。副本规则：相同collectible_effect_id的重复副本仍可放入背包并携带，但仅1份参与效果计算，其余副本不生效。"
incoming_ranged_dodge_chance = 0.2
