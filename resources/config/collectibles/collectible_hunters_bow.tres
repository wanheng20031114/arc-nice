collectible_design_id = "hunters_bow"
collectible_design_note = "猎人短弓规则：首次等待12秒且之后每12秒，选择持有者周围280范围内最近的至多2名存活敌人并各发射1箭；每箭先将当前攻击力×1.2四舍五入并至少取1，再加当前物理伤害加成，出手值至少为1点物理伤害；命中后减去目标有效物理防御并至少取1，再乘目标承伤倍率并四舍五入，最终至少为1点；没有有效目标时本次不发射但仍重新开始周期计时。副本规则：相同collectible_effect_id的重复副本仍可放入背包并携带，但仅1份参与效果计算，其余副本不生效。"
periodic_effect_id = "archer"
