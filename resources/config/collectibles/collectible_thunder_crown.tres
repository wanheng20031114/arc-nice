[ext_resource type="Script" path="res://resources/config/pickups/pickup_config.gd" id="2_script"]

[resource]
script = ExtResource("2_script")
pickup_type = 5
display_name = "雷冠"
drop_weight = 0.0
description = "使用技能时优先随机雷击自身周围256范围内1名敌人，附近无目标时改选全场，对击中点58范围敌人造成32法术伤害。"
can_store_in_inventory = true
icon_texture = ExtResource("1_icon")
icon_scale = Vector2(1, 1)
duration = 0.0
collectible_effect_id = "thunder_crown"
collectible_rarity = 2
collectible_design_id = "thunder_crown"
collectible_design_note = "雷冠规则：每次技能成功发动时优先从持有者周围256范围内的存活敌人中随机选择1名；该范围内没有目标时，改从全部存活敌人中随机选择1名；对其位置58范围内敌人造成配置值32点法术伤害；实际出手法术伤害为配置伤害加当前法术伤害加成，出手值至少为1点；命中后先将目标有效法术防御钳制在0至100，再计算max(floor(出手值×(100-有效法术防御)/100),1)，再乘目标承伤倍率并四舍五入，最终至少为1点。副本规则：相同collectible_effect_id的重复副本仍可放入背包并携带，但仅1份参与效果计算，其余副本不生效。"
trigger_effect_id = "skill_thunder"
trigger_damage = 32
trigger_radius = 58.0
metadata/_custom_type_script = "uid://qucrregg4cq0"
