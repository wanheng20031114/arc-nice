script = ExtResource("2_script")
pickup_type = 5
display_name = "纯净充能水晶"
drop_weight = 0.0
description = "使用技能时有20%概率不消耗技力（可叠加）。"
can_store_in_inventory = true
icon_texture = ExtResource("1_icon")
icon_scale = Vector2(1, 1)
duration = 0.0
collectible_effect_id = "pure_charge_crystal"
collectible_rarity = 3
collectible_design_id = "pure_charge_crystal"
collectible_design_note = "纯净充能水晶规则：每个生效副本使技能发动时保留全部技力的概率增加20个百分点；所有技能免耗概率按百分点相加，最终钳制在0%至100%。每个Player实例各自为技能1维护0.1秒最短成功发动间隔；不同玩家之间不共用该计时；即使免耗判定成功并保留满技力，同一玩家也不能绕过该间隔。副本规则：相同collectible_effect_id最多前5份参与效果计算；第6份及以后仍可放入背包并携带，但不再生效。角色兼容：候选池仅向普通攻击可生成投射物的角色提供此收藏品。"
collectible_stacks_by_copy = true
collectible_max_copies = 5
requires_projectile_primary_attack = true
skill_charge_preserve_chance = 0.2
metadata/_custom_type_script = "uid://qucrregg4cq0"
