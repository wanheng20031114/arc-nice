[resource]
script = ExtResource("2_script")
pickup_type = 5
display_name = "龙心"
drop_weight = 0.0
description = "击败敌人时对其位置48范围敌人造成18物理伤害，冷却0.6秒。"
can_store_in_inventory = true
icon_texture = ExtResource("1_icon")
icon_scale = Vector2(1, 1)
duration = 0.0
collectible_effect_id = "dragon_heart"
collectible_rarity = 2
collectible_design_id = "dragon_heart"
collectible_design_note = "龙心规则：玩家攻击命中并使敌人死亡时，若该效果不在冷却中则先启动0.6秒冷却，再以死亡位置为中心对48范围内敌人造成配置值18点物理伤害；实际出手物理伤害为配置伤害加当前物理伤害加成，出手值至少为1点；命中后先计算max(出手值-目标有效物理防御,1)，再乘目标承伤倍率并四舍五入，最终至少为1点。副本规则：相同collectible_effect_id的重复副本仍可放入背包并携带，但仅1份参与效果计算，其余副本不生效。"
kill_effect_id = "burst"
kill_cooldown = 0.6
kill_damage = 18
kill_radius = 48.0
