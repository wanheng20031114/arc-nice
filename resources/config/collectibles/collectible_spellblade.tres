[resource]
script = ExtResource("2_script")
pickup_type = 5
display_name = "咒刃"
drop_weight = 0.0
description = "攻击命中时，20%概率标记敌人2.5秒，使其额外受到18%伤害。"
can_store_in_inventory = true
icon_texture = ExtResource("1_icon")
icon_scale = Vector2(1, 1)
duration = 0.0
collectible_effect_id = "spellblade"
collectible_rarity = 2
collectible_design_id = "spellblade"
collectible_design_note = "咒刃规则：攻击命中基础伤害后仍存活的敌人时，先以20%概率判定；判定成功时标记目标2.5秒，使其受到的伤害乘以1.18（提高18%）；同一来源再次触发会刷新该状态，不同来源的承伤倍率彼此连乘；多个命中附加效果按背包槽及有效副本顺序依次处理；任一效果（包括处决）使目标死亡后立即停止后续命中附加效果，再按同一有效顺序处理击杀效果。副本规则：相同collectible_effect_id的重复副本仍可放入背包并携带，但仅1份参与效果计算，其余副本不生效。"
on_hit_effect_id = "mark"
on_hit_chance = 0.2
on_hit_duration = 2.5
on_hit_damage_taken_multiplier = 1.18
metadata/_custom_type_script = "uid://qucrregg4cq0"
