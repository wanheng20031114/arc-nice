collectible_design_id = "oracle_cube"
collectible_design_note = "先知方块规则：攻击命中基础伤害后仍存活的敌人时，先以24%概率判定；判定成功时标记目标3秒，使其受到的伤害乘以1.22（提高22%）；同一来源再次触发会刷新该状态，不同来源的承伤倍率彼此连乘；多个命中附加效果按背包槽及有效副本顺序依次处理；任一效果（包括处决）使目标死亡后立即停止后续命中附加效果，再按同一有效顺序处理击杀效果。副本规则：相同collectible_effect_id的重复副本仍可放入背包并携带，但仅1份参与效果计算，其余副本不生效。"
on_hit_effect_id = "mark"
on_hit_chance = 0.24
on_hit_duration = 3.0
on_hit_damage_taken_multiplier = 1.22
