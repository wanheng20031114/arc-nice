collectible_design_note = "水晶罗盘规则：攻击命中基础伤害后仍存活的敌人时，先以14%概率判定；判定成功且不在冷却时先启动0.7秒冷却，再获得4息壤；多个命中附加效果按背包槽及有效副本顺序依次处理；任一效果（包括处决）使目标死亡后立即停止后续命中附加效果，再按同一有效顺序处理击杀效果。副本规则：相同collectible_effect_id的重复副本仍可放入背包并携带，但仅1份参与效果计算，其余副本不生效。"
on_hit_effect_id = "xirang"
