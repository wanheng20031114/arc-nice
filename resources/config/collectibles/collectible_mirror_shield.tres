[ext_resource type="Script" path="res://resources/config/pickups/pickup_config.gd" id="2_script"]

[resource]
script = ExtResource("2_script")
pickup_type = 5
display_name = "镜面盾"
drop_weight = 0.0
description = "受伤时释放58范围寒霜，造成18法术伤害，并减速42%，持续1.8秒，冷却6秒。"
can_store_in_inventory = true
icon_texture = ExtResource("1_icon")
icon_scale = Vector2(1, 1)
duration = 0.0
collectible_effect_id = "mirror_shield"
collectible_rarity = 2
collectible_design_id = "mirror_shield"
collectible_design_note = "镜面盾规则：每次实际受到伤害且仍存活时若不在冷却中则先启动6秒冷却，再以持有者为中心对58范围内敌人造成配置值18点法术伤害，并使移速乘以0.58（降低42%），持续1.8秒；实际出手法术伤害为配置伤害加当前法术伤害加成，出手值至少为1点；命中后先将目标有效魔法防御钳制在0至100，再计算max(floor(出手值×(100-有效魔法防御)/100),1)，再乘目标承伤倍率并四舍五入，最终至少为1点；每次寒霜触发分配独立的临时减速来源；与寒冷及其他仍生效减速来源的移速倍率彼此连乘；每个来源独立计时，到期仅移除自身，并从敌人基础移速与其余仍生效倍率重新计算。副本规则：相同collectible_effect_id的重复副本仍可放入背包并携带，但仅1份参与效果计算，其余副本不生效。"
trigger_effect_id = "hurt_frost"
trigger_cooldown = 6.0
trigger_damage = 18
trigger_radius = 58.0
trigger_slow_multiplier = 0.58
trigger_slow_duration = 1.8
metadata/_custom_type_script = "uid://qucrregg4cq0"
