[ext_resource type="Script" path="res://resources/config/pickups/pickup_config.gd" id="2_script"]

[resource]
script = ExtResource("2_script")
pickup_type = 5
display_name = "弑王刃"
drop_weight = 0.0
description = "攻击命中时，24%概率处决生命不高于28%的非Boss敌人，冷却0.5秒。"
can_store_in_inventory = true
icon_texture = ExtResource("1_icon")
icon_scale = Vector2(1, 1)
duration = 0.0
collectible_effect_id = "kingslayer_blade"
collectible_rarity = 3
collectible_design_id = "kingslayer_blade"
collectible_design_note = "弑王刃规则：攻击命中基础伤害后仍存活的敌人时，Boss目标不会进行概率判定、不会触发处决且不会消耗冷却；其余敌人先以24%概率判定；判定成功且不在冷却时先启动0.5秒冷却，再仅在目标当前生命不高于其配置生命上限的28%时，额外提交“目标当前生命+目标配置生命上限”的原始物理伤害；目标没有配置或运行时生命上限无效时不会触发处决；该额外伤害仍会先减去目标有效物理防御并至少取1，再乘目标承伤倍率、四舍五入并至少取1；因此极高物理防御下不保证击杀；即使目标未达到处决生命阈值，或达到阈值但减伤后仍未死亡，成功的概率判定仍会消耗冷却；多个命中附加效果按背包槽及有效副本顺序依次处理；任一效果（包括处决）使目标死亡后立即停止后续命中附加效果，再按同一有效顺序处理击杀效果。副本规则：相同collectible_effect_id的重复副本仍可放入背包并携带，但仅1份参与效果计算，其余副本不生效。"
on_hit_effect_id = "execute"
on_hit_chance = 0.24
on_hit_cooldown = 0.5
on_hit_execute_health_ratio = 0.28
metadata/_custom_type_script = "uid://qucrregg4cq0"
