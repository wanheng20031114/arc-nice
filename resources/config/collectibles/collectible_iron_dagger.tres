[ext_resource type="Script" path="res://resources/config/pickups/pickup_config.gd" id="2_script"]

[resource]
script = ExtResource("2_script")
pickup_type = 5
display_name = "铁匕首"
drop_weight = 0.0
description = "攻击命中时，18%概率使敌人流血2秒，每0.5秒受1物理伤害。"
can_store_in_inventory = true
icon_texture = ExtResource("1_icon")
icon_scale = Vector2(1, 1)
duration = 0.0
collectible_effect_id = "iron_dagger"
collectible_rarity = 0
collectible_design_id = "iron_dagger"
collectible_design_note = "铁匕首规则：攻击命中基础伤害后仍存活的敌人时，先以18%概率判定；判定成功时施加持续2秒的流血，每0.5秒造成配置值1点物理伤害；实际出手物理伤害为配置伤害加当前物理伤害加成，出手值至少为1点；命中后先计算max(出手值-目标有效物理防御,1)，再乘目标承伤倍率并四舍五入，最终至少为1点；跳伤值在施加状态时快照当时的物理伤害加成，之后加成变化不会修改该状态，直至再次施加；同一来源再次触发会替换状态并重置持续与跳伤计时；不同来源的流血各自独立跳伤；多个命中附加效果按背包槽及有效副本顺序依次处理；任一效果（包括处决）使目标死亡后立即停止后续命中附加效果，再按同一有效顺序处理击杀效果。副本规则：相同collectible_effect_id的重复副本仍可放入背包并携带，但仅1份参与效果计算，其余副本不生效。"
on_hit_effect_id = "bleed"
on_hit_chance = 0.18
on_hit_damage = 1
on_hit_duration = 2.0
on_hit_tick_interval = 0.5
metadata/_custom_type_script = "uid://qucrregg4cq0"
