[ext_resource type="Script" path="res://resources/config/pickups/pickup_config.gd" id="2_script"]

[resource]
script = ExtResource("2_script")
pickup_type = 5
display_name = "守卫徽章"
drop_weight = 0.0
description = "受伤时随机雷击1名敌人，对击中点36范围敌人造成16法术伤害，冷却8秒。"
can_store_in_inventory = true
icon_texture = ExtResource("1_icon")
icon_scale = Vector2(1, 1)
duration = 0.0
collectible_effect_id = "guardian_badge"
collectible_rarity = 1
collectible_design_id = "guardian_badge"
collectible_design_note = "守卫徽章规则：每次实际受到伤害且仍存活时若不在冷却中则先启动8秒冷却，再从全部存活敌人中随机选择1名，并对其位置36范围内敌人造成配置值16点法术伤害；实际出手法术伤害为配置伤害加当前法术伤害加成，出手值至少为1点；命中后先将目标有效魔法防御钳制在0至100，再计算max(floor(出手值×(100-有效魔法防御)/100),1)，再乘目标承伤倍率并四舍五入，最终至少为1点；即使没有存活敌人可供落雷，冷却仍会消耗。副本规则：相同collectible_effect_id的重复副本仍可放入背包并携带，但仅1份参与效果计算，其余副本不生效。"
trigger_effect_id = "hurt_thunder"
trigger_cooldown = 8.0
trigger_damage = 16
trigger_radius = 36.0
metadata/_custom_type_script = "uid://qucrregg4cq0"
