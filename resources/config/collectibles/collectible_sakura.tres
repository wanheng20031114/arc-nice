[resource]
script = ExtResource("2_script")
pickup_type = 5
display_name = "樱花"
drop_weight = 0.0
description = "每10秒向最近1名敌人发射追踪樱花导弹，爆炸半径47，造成100法术伤害。"
can_store_in_inventory = true
icon_texture = ExtResource("1_icon")
icon_scale = Vector2(1, 1)
duration = 0.0
collectible_effect_id = "sakura"
collectible_rarity = 3
collectible_design_id = "sakura"
collectible_design_note = "樱花规则：首次等待10秒且之后每10秒，在全部距离内按距离查询至多1名存活敌人；搜索半径配置为0时表示不限制距离；无论查询上限是多少，实际只向查询结果第1名即最近目标发射1枚追踪樱花导弹；爆炸半径47，配置值100点法术伤害；实际出手法术伤害为配置伤害加当前法术伤害加成，出手值至少为1点；命中后先将目标有效魔法防御钳制在0至100，再计算max(floor(出手值×(100-有效魔法防御)/100),1)，再乘目标承伤倍率并四舍五入，最终至少为1点；没有有效目标时本次不发射但仍重新开始周期计时。副本规则：相同collectible_effect_id的重复副本仍可放入背包并携带，但仅1份参与效果计算，其余副本不生效。"
periodic_effect_id = "sakura_rocket"
periodic_interval = 10.0
periodic_damage = 100
periodic_target_count = 1
metadata/_custom_type_script = "uid://qucrregg4cq0"
