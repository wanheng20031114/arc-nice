[resource]
script = ExtResource("2_script")
pickup_type = 5
display_name = "寒霜图腾"
drop_weight = 0.0
description = "每13秒释放56范围寒霜，造成8法术伤害，并减速35%，持续1.5秒。"
can_store_in_inventory = true
icon_texture = ExtResource("1_icon")
icon_scale = Vector2(1, 1)
duration = 0.0
collectible_effect_id = "frost_totem"
collectible_rarity = 1
collectible_design_id = "frost_totem"
collectible_design_note = "寒霜图腾规则：首次等待13秒且之后每13秒，以持有者为中心影响56范围敌人，造成配置值8点法术伤害，并使移速乘以0.65（降低35%），持续1.5秒；实际出手法术伤害为配置伤害加当前法术伤害加成，出手值至少为1点；命中后先将目标有效法术防御钳制在0至100，再计算max(floor(出手值×(100-有效法术防御)/100),1)，再乘目标承伤倍率并四舍五入，最终至少为1点；每次寒霜触发分配独立的临时减速来源；与寒冷及其他仍生效减速来源的移速倍率彼此连乘；每个来源独立计时，到期仅移除自身，并从敌人基础移速与其余仍生效倍率重新计算。副本规则：相同collectible_effect_id的重复副本仍可放入背包并携带，但仅1份参与效果计算，其余副本不生效。"
periodic_effect_id = "frost"
periodic_interval = 13.0
periodic_radius = 56.0
periodic_damage = 8
periodic_slow_multiplier = 0.65
periodic_slow_duration = 1.5
metadata/_custom_type_script = "uid://qucrregg4cq0"
