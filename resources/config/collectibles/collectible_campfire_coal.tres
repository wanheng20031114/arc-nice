[ext_resource type="Script" path="res://resources/config/pickups/pickup_config.gd" id="2_script"]

[resource]
script = ExtResource("2_script")
pickup_type = 5
display_name = "篝火余烬"
drop_weight = 0.0
description = "攻击命中时，16%概率使敌人燃烧2.4秒，每1秒受10法术伤害。"
can_store_in_inventory = true
icon_texture = ExtResource("1_icon")
icon_scale = Vector2(1, 1)
duration = 0.0
collectible_effect_id = "campfire_coal"
collectible_rarity = 1
collectible_design_id = "campfire_coal"
collectible_design_note = "篝火余烬规则：攻击命中基础伤害后仍存活的敌人时，先以16%概率判定；判定成功时施加持续2.4秒的燃烧，每1秒造成配置值10点法术伤害；实际出手法术伤害为配置伤害加当前法术伤害加成，出手值至少为1点；命中后先将目标有效法术防御钳制在0至100，再计算max(floor(出手值×(100-有效法术防御)/100),1)，再乘目标承伤倍率并四舍五入，最终至少为1点；跳伤值在施加状态时快照当时的法术伤害加成，之后加成变化不会修改该状态，直至再次施加；同一来源再次触发会替换状态并重置持续与跳伤计时；多个燃烧来源同时存在时仅跳伤值最高的一条推进并造成跳伤，其余燃烧的持续时间继续流逝但跳伤倒计时暂停；多个命中附加效果按背包槽及有效副本顺序依次处理；任一效果（包括处决）使目标死亡后立即停止后续命中附加效果，再按同一有效顺序处理击杀效果。副本规则：相同collectible_effect_id的重复副本仍可放入背包并携带，但仅1份参与效果计算，其余副本不生效。"
on_hit_effect_id = "burn"
on_hit_chance = 0.16
on_hit_damage = 10
on_hit_duration = 2.4
on_hit_tick_interval = 1.0
metadata/_custom_type_script = "uid://qucrregg4cq0"
