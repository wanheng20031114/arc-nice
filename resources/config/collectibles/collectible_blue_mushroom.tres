collectible_design_note = "蓝蘑菇规则：攻击命中基础伤害后仍存活的敌人时，先以12%概率判定；判定成功时施加持续1.5秒的寒冷，使移速乘以0.78（降低22%）；同一来源再次触发会刷新该状态，不同来源的移速倍率彼此连乘；多个命中附加效果按背包槽及有效副本顺序依次处理；任一效果（包括处决）使目标死亡后立即停止后续命中附加效果，再按同一有效顺序处理击杀效果。副本规则：相同collectible_effect_id的重复副本仍可放入背包并携带，但仅1份参与效果计算，其余副本不生效。"
on_hit_effect_id = "chill"
on_hit_chance = 0.12
on_hit_duration = 1.5
on_hit_slow_multiplier = 0.78
