[resource]
script = ExtResource("1_config")
character_id = &"tango"
display_name = "探戈"
english_name = "Tango"
title = "瓦砾中的具身机器人"
description = "由三台释术单元伴飞的机械生命。常态长按蓄能并持续齐射，也能释放电涌区域压制并标记成群敌人。"
playstyle = "远程 · 蓄力齐射 · 电涌压制"
player_scene = "res://scene/player/tango/player_tango.tscn"
portrait_texture = "res://resources/texture/player/tango/portrait.png"
skill_display_name = "电能涌动"
skill_description = "以自身为中心生成持续8秒、半径72的电涌区域，每秒造成20点固定法术伤害，使敌人永久附着电磁，并在区域内降低35%移动速度。技能期间无需按下攻击键，Tango会持续以满蓄力状态自动射击，玩家只需控制射击方向；攻击速度提高50%，对电磁附着的敌人额外造成20%伤害。"
skill_icon_texture = "res://resources/texture/player/tango/skill1_icon.png"
starting_max_health = 60
starting_attack_speed = 240.0
card_background_color = Color(0.065, 0.085, 0.105, 0.98)
card_edge_color = Color(0.29, 0.72, 0.75, 1)
card_hover_edge_color = Color(0.38, 0.93, 0.95, 1)
card_accent_color = Color(0.22, 0.86, 0.89, 1)
card_button_color = Color(0.16, 0.38, 0.41, 1)
card_text_color = Color(0.91, 0.96, 0.96, 1)
