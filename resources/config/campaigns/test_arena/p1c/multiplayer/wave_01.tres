count = 500

[sub_resource type="Resource" id="Resource_cardboard_monster_large_entry"]
script = ExtResource("1_entry_script")
enemy_config = ExtResource("4_cardboard_monster_large")
count = 500

[resource]
script = ExtResource("3_wave_script")
wave_name = "第1波 大小纸箱怪轮转测试（多人）"
enemy_entries = Array[ExtResource("1_entry_script")]([SubResource("Resource_cardboard_monster_entry"), SubResource("Resource_cardboard_monster_large_entry")])
