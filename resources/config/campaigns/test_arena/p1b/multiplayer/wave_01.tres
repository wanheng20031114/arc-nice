[gd_resource type="Resource" script_class="WaveConfig" format=3]

[ext_resource type="Script" path="res://resources/config/waves/wave_enemy_entry.gd" id="1_entry_script"]
[ext_resource type="Resource" path="res://resources/config/enemies/combat_robot.tres" id="2_combat_robot"]
[ext_resource type="Resource" path="res://resources/config/enemies/combat_robot_gunner.tres" id="3_combat_robot_gunner"]
[ext_resource type="Script" path="res://resources/config/waves/wave_config.gd" id="4_wave_script"]
[ext_resource type="Resource" path="res://resources/config/enemies/combat_robot_drone_operator.tres" id="5_combat_robot_drone_operator"]
[ext_resource type="Resource" path="res://resources/config/enemies/combat_robot_shield_bearer.tres" id="6_combat_robot_shield_bearer"]

[sub_resource type="Resource" id="Resource_combat_robot_entry"]
script = ExtResource("1_entry_script")
enemy_config = ExtResource("2_combat_robot")
count = 250

[sub_resource type="Resource" id="Resource_combat_robot_gunner_entry"]
script = ExtResource("1_entry_script")
enemy_config = ExtResource("3_combat_robot_gunner")
count = 250

[sub_resource type="Resource" id="Resource_combat_robot_drone_operator_entry"]
script = ExtResource("1_entry_script")
enemy_config = ExtResource("5_combat_robot_drone_operator")
count = 250

[sub_resource type="Resource" id="Resource_combat_robot_shield_bearer_entry"]
script = ExtResource("1_entry_script")
enemy_config = ExtResource("6_combat_robot_shield_bearer")
count = 250

[resource]
script = ExtResource("4_wave_script")
wave_name = "第1波 四型战斗机器人轮转测试（多人）"
enemy_entries = Array[ExtResource("1_entry_script")]([SubResource("Resource_combat_robot_entry"), SubResource("Resource_combat_robot_gunner_entry"), SubResource("Resource_combat_robot_drone_operator_entry"), SubResource("Resource_combat_robot_shield_bearer_entry")])
spawn_point_mask = 3
spawn_order = 1
spawn_interval = 3.0
spawn_count_per_tick = 1
max_alive_enemies = 1000
step_id = &"wave_01"
display_name = "第1波 四型战斗机器人严格轮转（各250台）"
