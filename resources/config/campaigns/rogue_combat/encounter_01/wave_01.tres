[gd_resource type="Resource" script_class="WaveConfig" load_steps=4 format=3]

[ext_resource type="Script" path="res://resources/config/waves/wave_enemy_entry.gd" id="1_entry_script"]
[ext_resource type="Resource" path="res://resources/config/enemies/combat_robot.tres" id="2_combat_robot"]
[ext_resource type="Script" path="res://resources/config/waves/wave_config.gd" id="3_wave_script"]

[sub_resource type="Resource" id="CombatRobotEntry"]
script = ExtResource("1_entry_script")
enemy_config = ExtResource("2_combat_robot")
count = 10
xirang_kill_reward_override = -1

[resource]
script = ExtResource("3_wave_script")
wave_name = "狭路相逢"
enemy_entries = Array[ExtResource("1_entry_script")]([SubResource("CombatRobotEntry")])
spawn_point_mask = 31
spawn_interval = 0.1
spawn_count_per_tick = 10
max_alive_enemies = 10
step_id = &"wave_01"
display_name = "狭路相逢：击败全部作战机器人"
