  "style_contract": {
    "logical_canvas": "32x32",
    "visual_style": "Minecraft-like cartoon pixel art",
    "palette": "limited",
    "readability": "recognizable at a glance",
    "avoid": [
      "photorealism",
      "Chinese legendary web-game rendering",
      "smooth gradients",
      "dense decorative clutter",
      "multiple generated assets in one step"
    ],
